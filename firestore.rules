rules_version = '2';

// Who can do what from the browser (the web app).
// The scraper writes with a service account, which bypasses these rules,
// so browsers never need write access.
service cloud.firestore {
  match /databases/{database}/documents {

    // Any signed-in Google account can read. To restrict access to specific
    // people, replace `signedIn()` with `allowed()` and list their emails.
    function signedIn() {
      return request.auth != null;
    }
    function allowed() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email in ['someone@example.com'];
    }

    match /summaries/{doc} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /listings/{doc} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /runs/{doc} {
      allow read: if signedIn();
      allow write: if false;
    }
    // everything else: closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
